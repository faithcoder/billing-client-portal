# PROPOSED one-origin configuration; validate paths, FPM socket, DNS/TLS on host.
server {
    listen 443 ssl;
    server_name portal.example.invalid;
    ssl_certificate /etc/ssl/portal/fullchain.pem;
    ssl_certificate_key /etc/ssl/portal/privkey.pem;
    root /srv/water/current/frontend/dist;
    index index.html;
    client_max_body_size 6m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;

    # API includes all auth mutations, exports, private downloads and callbacks.
    location ~ ^/(api|sanctum)(/|$) {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /srv/water/current/backend/public/index.php;
        fastcgi_param DOCUMENT_ROOT /srv/water/current/backend/public;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param HTTPS on;
        fastcgi_pass unix:/run/php/php8.5-fpm.sock;
        fastcgi_read_timeout 60s;
        add_header Cache-Control "private, no-store" always;
    }
    location = /up {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /srv/water/current/backend/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param HTTPS on;
        fastcgi_pass unix:/run/php/php8.5-fpm.sock;
        add_header Cache-Control "no-store" always;
    }
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location ~ /\. { deny all; }
    location ~ \.php$ { return 404; }
    location ~ ^/(storage|backend|vendor|docs)(/|$) { return 404; }
    location = /sw.js { try_files $uri =404; add_header Cache-Control "no-cache"; }
    location = /manifest.webmanifest { try_files $uri =404; add_header Cache-Control "no-cache"; }
    location ~ ^/offline.*\.html$ { try_files $uri =404; add_header Cache-Control "no-cache"; }
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
server {
    listen 80;
    server_name portal.example.invalid;
    return 301 https://portal.example.invalid$request_uri;
}
