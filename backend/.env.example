APP_NAME="Water Service Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=water_portal
DB_USERNAME=water_portal
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5173,127.0.0.1:4173,127.0.0.1:8000,localhost:5173,localhost:4173,localhost:8000
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.invalid"
MAIL_FROM_NAME="Water Service Portal"
# Only local/testing may use mock. Live adapter uses an unconfirmed PROPOSED contract.
BILLING_MODE=mock
BILLING_API_URL=
BILLING_API_TOKEN=

NOTIFICATION_DRIVER=fake
UPLOAD_SCANNER=unavailable

# All external routes are PROPOSED. Never enable without contract review.
BILLING_CONTRACT_APPROVED=false
BILLING_ALLOWED_HOSTS=
BILLING_IDEMPOTENT_POSTING=false
BILLING_REFERENCE_LOOKUP=false
BILLING_ATOMIC_SETTLEMENT=false

PAYMENT_GATEWAY=fake
PAYMENT_MERCHANT_ID=demo-merchant
